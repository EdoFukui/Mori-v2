# --- Variables para el cliente (Vite las expone al navegador) ---
# Usadas por src/lib/supabase.ts. Seguras de exponer: la anon key solo
# funciona a través de las policies RLS de supabase/migrations/0001_*.sql.
VITE_SUPABASE_URL=https://tuiniciodeurl.supabase.co
VITE_SUPABASE_ANON_KEY=laprimerakey

# --- Variables SOLO para scripts locales (nunca deben ir a src/) ---
# Usadas por scripts/migrate-plantas.mjs. La service_role bypassea RLS
# por completo: no debe usarse en ningún archivo dentro de src/, ni
# subirse a ningún repo. Pégala tú mismo en tu .env local — nunca la
# compartas en un chat, ni siquiera con Claude: quien la tenga tiene
# acceso total a la base de datos sin restricción de RLS.
SUPABASE_URL=https://tjgkzzpvqrqvmshcwwtl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=lasegundakey

# --- Rutas locales para el script de migración (opcionales) ---
# Si no se definen, el script busca en ../mori1-source/ relativo a
# scripts/. Ver README de esta capa para dónde copiar los archivos del
# zip de Mori 1.0.
MORI1_JSON_PATH=./mori1-source/plantas.json
MORI1_ASSETS_DIR=./mori1-source/ejemplares
